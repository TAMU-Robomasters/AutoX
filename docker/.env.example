# Copy to `.env` (same dir) and adjust. Read automatically by docker compose.

# ROS 2 distro for both images (Humble = Ubuntu 22.04 = Python 3.10).
ROS_DISTRO=humble

# DDS graph: BOTH services and any host-side ROS must share these to discover
# each other (we use network_mode: host).
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Gazebo/RViz rendering. 1 = software GL (portable, works headless). Set to 0 and
# enable the nvidia runtime (see README "GUI / GPU") for hardware GL.
LIBGL_ALWAYS_SOFTWARE=1

# For GUI (Gazebo/RViz) windows on the host X server: `export DISPLAY=$DISPLAY`
# and run `xhost +local:docker` once on the host.
DISPLAY=
